{
  "name": "pinia-cached-store",
  "version": "0.7.0",
  "description": "Pinia store extension that allows transparent caching of state in local storage.",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "scripts": {
    "build": "rimraf dist && rollup -c rollup.config.mjs",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iWeltAG/pinia-cached-store.git"
  },
  "keywords": [
    "vue",
    "store",
    "pinia",
    "typescript",
    "localstorage"
  ],
  "author": "iWelt AG",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iWeltAG/pinia-cached-store/issues"
  },
  "homepage": "https://github.com/iWeltAG/pinia-cached-store#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "pinia": "^4.0.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.0"
  }
}
